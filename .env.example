# Pick a provider preset (mistral | openai | openrouter) or set LLM_BASE_URL yourself.
# If unset, the first provider whose API key is present is used.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# Optional overrides
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=mistral-medium-latest       # parsing, assessment, proposals, QA
# LLM_CODE_MODEL=codestral-latest       # writing the task scripts
# LLM_PRICE_INPUT=0.4                   # USD per 1M input tokens (unknown models)
# LLM_PRICE_OUTPUT=2.0                  # USD per 1M output tokens (unknown models)
